# This demo runs entirely on local mock JSON fixtures and an in-memory
# repository — no environment variables are required to run `pnpm dev`.
#
# The variables below are illustrative only, showing the shape of config
# a real deployment of this architecture would need. None of them are
# read by any code in this repository.

# 示例：后端 API 地址（本 demo 未使用，纯 mock 数据）
NEXT_PUBLIC_API_URL=

# 示例：当前部署环境标识（demo 未使用）
NEXT_PUBLIC_APP_ENV=development
